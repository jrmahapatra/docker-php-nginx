FROM alpine:latest

LABEL Maintainer="Janaki Mahapatra <mailme@mjanaki.com>"
LABEL Description="Lightweight container with Nginx 1.22 & PHP 8 based on Alpine Linux."

# Setup document root
WORKDIR /var/www/html

# Install base packages and PHP with extensions in a single layer
RUN echo "UTC" > /etc/timezone && \
    apk add --no-cache \
    bash \
    zip \
    unzip \
    curl \
    sqlite \
    nginx \
    supervisor \
    php82 \
    php82-common \
    php82-fpm \
    php82-intl \
    php82-gd \
    php82-mysqli \
    php82-pdo \
    php82-opcache \
    php82-zip \
    php82-phar \
    php82-iconv \
    php82-cli \
    php82-curl \
    php82-openssl \
    php82-mbstring \
    php82-tokenizer \
    php82-fileinfo \
    php82-json \
    php82-xml \
    php82-xmlwriter \
    php82-simplexml \
    php82-dom \
    php82-pdo_mysql \
    php82-pdo_sqlite \
    php82-pecl-redis \
    php82-dev \
    php82-pear \
    php82-exif \
    php82-ctype \
    php82-xmlreader \
    php82-session \
    php82-bcmath \
    php82-calendar \
    php82-gettext \
    php82-sockets \
    autoconf && \
    sed -i 's/bin\/ash/bin\/bash/g' /etc/passwd

# Create symlink so programs depending on `php` still function
RUN ln -s /usr/bin/php82 /usr/bin/php
RUN ln -s /usr/bin/pecl82 /usr/bin/pecl


# Install build dependencies
RUN apk --no-cache add \
    g++ \
    gcc \
    unixodbc-dev \
    gnupg \
    gpg \
    make \
    autoconf \
    libtool \
    m4 \
    php82-dev \
    php82-pear \
    unixodbc \
    file \
    re2c \
    build-base \
    php82-phpdbg \
    php82-openssl \
    php82-common \
    linux-headers \
    musl-dev \
    php82-pdo

# Create necessary symlinks
RUN ln -sf /usr/bin/phpize82 /usr/bin/phpize && \
    ln -sf /usr/bin/php-config82 /usr/bin/php-config && \
    ln -sf /usr/bin/pecl82 /usr/bin/pecl

# Configure PECL and PDO (removing redundant PDO loading)
# RUN echo "extension=pdo.so" > /etc/php82/conf.d/10_pdo.ini    # Comment out or remove this line

# Determine architecture and set variables
ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        ODBC_PACKAGE="msodbcsql18_18.3.2.1-1_arm64.apk"; \
        TOOLS_PACKAGE="mssql-tools18_18.3.1.1-1_arm64.apk"; \
    else \
        ODBC_PACKAGE="msodbcsql17_17.10.2.1-1_amd64.apk"; \
        TOOLS_PACKAGE="mssql-tools_17.10.1.1-1_amd64.apk"; \
    fi && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        curl -O https://download.microsoft.com/download/3/5/5/355d7943-a338-41a7-858d-53b259ea33f5/$ODBC_PACKAGE && \
        curl -O https://download.microsoft.com/download/3/5/5/355d7943-a338-41a7-858d-53b259ea33f5/$TOOLS_PACKAGE; \
    else \
        curl -O https://download.microsoft.com/download/e/4/e/e4e67866-dffd-428c-aac7-8d28ddafb39b/$ODBC_PACKAGE && \
        curl -O https://download.microsoft.com/download/e/4/e/e4e67866-dffd-428c-aac7-8d28ddafb39b/$TOOLS_PACKAGE; \
    fi && \
    curl https://packages.microsoft.com/keys/microsoft.asc | gpg --import - && \
    apk add --allow-untrusted $ODBC_PACKAGE && \
    apk add --allow-untrusted $TOOLS_PACKAGE

# Install SQL Server extensions with dependencies
RUN curl -O https://download.microsoft.com/download/b/9/f/b9f3cce4-3925-46d4-9f46-da08869c6486/msodbcsql18_18.1.1.1-1_amd64.apk && \
    curl -O https://download.microsoft.com/download/b/9/f/b9f3cce4-3925-46d4-9f46-da08869c6486/mssql-tools18_18.1.1.1-1_amd64.apk && \
    apk add --allow-untrusted msodbcsql18_18.1.1.1-1_amd64.apk mssql-tools18_18.1.1.1-1_amd64.apk && \
    apk add --no-cache \
        unixodbc-dev \
        php82-dev \
        php82-pear \
        build-base \
        gnupg \
        linux-headers \
        && \
    curl https://packages.microsoft.com/keys/microsoft.asc | gpg --import - && \
    curl -O https://github.com/Microsoft/msphpsql/releases/download/v5.10.1/alpine/php-8.2/sqlsrv.so && \
    curl -O https://github.com/Microsoft/msphpsql/releases/download/v5.10.1/alpine/php-8.2/pdo_sqlsrv.so && \
    mkdir -p /usr/lib/php82/modules && \
    mv sqlsrv.so /usr/lib/php82/modules/ && \
    mv pdo_sqlsrv.so /usr/lib/php82/modules/ && \
    echo "extension=sqlsrv.so" > /etc/php82/conf.d/20_sqlsrv.ini && \
    echo "extension=pdo_sqlsrv.so" > /etc/php82/conf.d/30_pdo_sqlsrv.ini && \
    chmod 644 /usr/lib/php82/modules/sqlsrv.so && \
    chmod 644 /usr/lib/php82/modules/pdo_sqlsrv.so && \
    echo "PHP Modules:" && \
    php -m && \
    echo "Extension directory:" && \
    php -i | grep "extension_dir"

# Install composer from the official image
COPY --from=composer /usr/bin/composer /usr/bin/composer

RUN mkdir -p /.composer && chown -R nobody:nobody /.composer

# Configure nginx
COPY config/nginx.conf /etc/nginx/nginx.conf

# Configure PHP-FPM
COPY config/fpm-pool.conf /etc/php82/php-fpm.d/www.conf
COPY config/php.ini /etc/php82/conf.d/custom.ini

# Configure supervisord
COPY config/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Add Microsoft repository and install SQL Server extensions
RUN apk add --no-cache \
        unixodbc-dev \
        php82-dev \
        php82-pear \
        build-base \
        gnupg \
        linux-headers \
        curl \
        wget \
        musl-dev \
        autoconf \
        libtool \
        m4 \
    && \
    # Setup GPG
    mkdir -p ~/.gnupg && \
    chmod 700 ~/.gnupg && \
    echo "disable-ipv6" >> ~/.gnupg/dirmngr.conf && \
    # Determine architecture
    architecture=$(case $(uname -m) in \
        x86_64) echo "amd64" ;; \
        aarch64) echo "arm64" ;; \
        *) echo "unsupported" ;; \
    esac) && \
    if [ "$architecture" = "unsupported" ]; then \
        echo "Architecture $(uname -m) is not supported" && exit 1; \
    fi && \
    # Download Microsoft packages
    curl -O https://download.microsoft.com/download/7/6/d/76de322a-d860-4894-9945-f0cc5d6a45f8/msodbcsql18_18.4.1.1-1_${architecture}.apk && \
    curl -O https://download.microsoft.com/download/7/6/d/76de322a-d860-4894-9945-f0cc5d6a45f8/mssql-tools18_18.4.1.1-1_${architecture}.apk && \
    # Import Microsoft key and install packages
    curl https://packages.microsoft.com/keys/microsoft.asc | gpg --import --no-default-keyring --keyring ./microsoft.gpg && \
    apk add --allow-untrusted msodbcsql18_18.4.1.1-1_${architecture}.apk && \
    apk add --allow-untrusted mssql-tools18_18.4.1.1-1_${architecture}.apk && \
    # Install PHP extensions
    if [ "$TARGETARCH" = "arm64" ]; then \
        echo "Installing ARM64 SQL Server extensions..." && \
        CFLAGS="-O2 -march=armv8-a" \
        CXXFLAGS="-O2 -march=armv8-a" \
        LDFLAGS="-lstdc++" \
        pecl install sqlsrv-5.9.0 && \
        CFLAGS="-O2 -march=armv8-a" \
        CXXFLAGS="-O2 -march=armv8-a" \
        LDFLAGS="-lstdc++" \
        pecl install pdo_sqlsrv-5.9.0; \
    else \
        echo "Installing AMD64 SQL Server extensions..." && \
        CFLAGS="-O2" \
        CXXFLAGS="-O2" \
        LDFLAGS="-lstdc++" \
        pecl install sqlsrv-5.9.0 && \
        CFLAGS="-O2" \
        CXXFLAGS="-O2" \
        LDFLAGS="-lstdc++" \
        pecl install pdo_sqlsrv-5.9.0; \
    fi && \
    # Configure extensions
    mkdir -p /etc/php82/conf.d && \
    echo "extension=sqlsrv.so" > /etc/php82/conf.d/20_sqlsrv.ini && \
    echo "extension=pdo_sqlsrv.so" > /etc/php82/conf.d/30_pdo_sqlsrv.ini && \
    # Set permissions
    chown -R nobody:nobody /etc/php82/conf.d && \
    chmod 644 /etc/php82/conf.d/*.ini && \
    # Debug information
    echo "Architecture: $architecture" && \
    echo "Files in modules directory:" && \
    ls -la /usr/lib/php82/modules/ && \
    echo "ODBC drivers:" && \
    odbcinst -j && \
    echo "PHP Modules:" && \
    php -m && \
    echo "Extension directory:" && \
    php -i | grep "extension_dir"

# Make sure files/folders needed by the processes are accessable when they run under the nobody user
RUN chown -R nobody:nobody /var/www/html /run /var/lib/nginx /var/log/nginx

# Switch to use a non-root user from here on
USER nobody

# Add application
# COPY --chown=nobody ./ /var/www/html/

# Expose the port nginx is reachable on
EXPOSE 80

# Let supervisord start nginx & php-fpm
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

# Configure a healthcheck to validate that everything is up&running
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl --silent --fail http://127.0.0.1:80/fpm-ping && \
        curl --silent --fail http://127.0.0.1:80/ping
